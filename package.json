{
  "name": "gestor-de-documentos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite build && wrangler d1 migrations apply gestor-documentos-db --local && node scripts/dev-server.mjs",
    "build": "vite build",
    "deploy": "vite build && wrangler d1 migrations apply gestor-documentos-db --remote && wrangler deploy",
    "cf:migrate:local": "wrangler d1 migrations apply gestor-documentos-db --local",
    "cf:migrate:remote": "wrangler d1 migrations apply gestor-documentos-db --remote",
    "cf:types": "wrangler types",
    "migrate:data": "node scripts/migrate-from-json.mjs",
    "clean": "rm -rf dist .wrangler",
    "lint": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "node --test tests/worker.test.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "hono": "^4.13.18",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wrangler": "^4.162.0"
  },
  "packageManager": "npm@10.9.2"
}
